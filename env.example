# Salin file ini menjadi .env (tidak ikut di-commit), lalu isi dua nilai dari
# Supabase Dashboard → tombol "Connect" atau Settings → API Keys.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) — di proyek lama namanya "anon public".
VITE_SUPABASE_ANON_KEY=isi-publishable-key-di-sini
